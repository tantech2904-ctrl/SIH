# ============================================================
#  ULPF — Universal Log Pre-Processing Framework
#  .gitignore
# ============================================================

# ------------------------------------------------------------
#  Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example
!.env.docker
!.env.local
.env.live
.env.bak.*
*.pem
*.key
*.crt
!frontend/**/*.crt
secrets/
credentials/
.ulpf/
connector.json
!scripts/ulpf-connector/config.example.json

# ------------------------------------------------------------
#  Runtime state (created at runtime, never committed)
# ------------------------------------------------------------
logs/
*.log
*.log.*
spool/
*.jsonl
*.bookmark.json
win_eventlog.bookmark.json
journald.cursor

# ------------------------------------------------------------
#  Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
data/
# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
scripts/ulpf-connector/venv/
scripts/ulpf-connector/.venv/

# Testing
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.cache

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.pyre/
pylint.d/

# Jupyter / notebooks
.ipynb_checkpoints/
*.ipynb

# Alembic scratch
alembic/versions/*.py.bak

# ------------------------------------------------------------
#  Node / Frontend
# ------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build output
dist/
build/
frontend/dist/
frontend/build/
frontend/.vite/
.vite/
*.tsbuildinfo
.eslintcache

# Package manager lockfiles: commit these if you want
# reproducible builds, otherwise uncomment:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ------------------------------------------------------------
#  Docker
# ------------------------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml
*.dockerfile.bak
.dockerignore.bak

# ------------------------------------------------------------
#  IDE / Editor
# ------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ------------------------------------------------------------
#  OS cruft
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# ------------------------------------------------------------
#  Windows-specific
# ------------------------------------------------------------
*.bat.bak
*.cmd.bak
*.ps1.bak
*.reg
*.msi
*.exe
*.dll
*.pdb

# ------------------------------------------------------------
#  Backups / archives
# ------------------------------------------------------------
*.bak
*.backup
*.old
*.orig
*.rej
*.tmp
*.temp
*.swp
*~
*.tar
*.tar.gz
*.tgz
*.zip
!**/*.zip.example

# ------------------------------------------------------------
