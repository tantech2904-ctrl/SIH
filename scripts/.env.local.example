# ============================================================
# ULPF - Local Mode Configuration
#
# Used automatically when Docker is not available.
# Self-contained: no Postgres, no Redis, no MinIO required.
#
#   - Database:        SQLite file at backend/ulpf_local.db
#   - Queue:           in-memory (enrichment is best-effort / skipped)
#   - Object storage:  local disk under backend/data/raw/
#
# Internet is optional. All core pipeline stages work offline.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_NAME=ULPF
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (SQLite, file-based) ----
DATABASE_URL=sqlite:///./ulpf_local.db

# ---- Queue (in-memory; no Redis server required) ----
REDIS_URL=memory://

# ---- Auth ----
JWT_SECRET=ulpf-local-development-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Object storage (blank = local disk fallback) ----
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ulpf-raw
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=

# ---- Upload limits ----
MAX_UPLOAD_BYTES=52428800
MAX_EVENT_BYTES=1048576

# ---- Syslog UDP listener (off by default) ----
SYSLOG_UDP_ENABLED=false
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=5140

# ---- File tail (off by default) ----
LOG_TAIL_ENABLED=false
LOG_TAIL_PATHS=
LOG_TAIL_POLL_SECONDS=1.0
LOG_TAIL_FROM_START=false

# ---- Rate limits ----
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_INGEST=600/minute
RATE_LIMIT_SEARCH=120/minute
RATE_LIMIT_ENRICH=60/minute
RATE_LIMIT_REPLAY=30/minute

# ---- Enrichment (all optional; disabled by default in local mode) ----
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_UPLOAD_FILES=false

ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=false

OTX_API_KEY=
OTX_ENABLED=false

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=
GEOIP_ENABLED=false

RDAP_ENABLED=false
DNS_ENABLED=false

STIX_TAXII_URL=
STIX_TAXII_USER=
STIX_TAXII_PASS=
STIX_TAXII_ENABLED=false

ENRICHMENT_HTTP_TIMEOUT_SECONDS=6
ENRICHMENT_CACHE_TTL_HOURS=24
ENRICHMENT_CIRCUIT_BREAKER_FAILURES=5
ENRICHMENT_CIRCUIT_BREAKER_RESET_SECONDS=60

# ---- Detection ----
RISK_AUTO_QUARANTINE_BELOW_CONFIDENCE=0.55
CORRELATION_WINDOW_SECONDS=300

# ---- Retention ----
RETENTION_RAW_EVIDENCE_DAYS=90
RETENTION_EVENTS_DAYS=180
RETENTION_AUDIT_DAYS=365
RETENTION_CACHE_DAYS=7

# ---- Bootstrap users ----
BOOTSTRAP_ADMIN_EMAIL=admin@ulpf.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin123!

BOOTSTRAP_ANALYST_EMAIL=analyst@ulpf.local
BOOTSTRAP_ANALYST_PASSWORD=ChangeMe_Analyst123!

BOOTSTRAP_AUDITOR_EMAIL=auditor@ulpf.local
BOOTSTRAP_AUDITOR_PASSWORD=ChangeMe_Auditor123!