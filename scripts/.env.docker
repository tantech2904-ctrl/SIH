# ============================================================
#  ULPF - .env for DOCKER mode
#  Written by scripts\run_docker.bat
# ============================================================

# --- App ---
APP_ENV=production
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# --- Postgres (container) ---
POSTGRES_USER=ulpf
POSTGRES_PASSWORD=ulpf
POSTGRES_DB=ulpf

# --- Backend DB connection (service name) ---
DATABASE_URL=postgresql+psycopg://ulpf:ulpf@postgres:5432/ulpf

# --- Redis (container) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (container) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ulpf-raw
MINIO_SECURE=false
STORAGE_BACKEND=minio

# --- Auth ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

BOOTSTRAP_ADMIN_EMAIL=admin@ulpf.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin123!
BOOTSTRAP_ANALYST_EMAIL=analyst@ulpf.local
BOOTSTRAP_ANALYST_PASSWORD=ChangeMe_Analyst123!
BOOTSTRAP_AUDITOR_EMAIL=auditor@ulpf.local
BOOTSTRAP_AUDITOR_PASSWORD=ChangeMe_Auditor123!

# --- Ingestion ---
MAX_EVENT_BYTES=1048576

# --- Listeners (off by default) ---
SYSLOG_UDP_ENABLED=false
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=5140

LOG_TAIL_ENABLED=false
LOG_TAIL_PATHS=/app/logs
LOG_TAIL_POLL_SECONDS=2
LOG_TAIL_FROM_START=false

# --- Enrichment (optional) ---
ENRICHMENT_ENABLED=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# --- Rate limits ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_INGEST=600/minute
RATE_LIMIT_SEARCH=120/minute
RATE_LIMIT_ENRICH=60/minute
RATE_LIMIT_REPLAY=30/minute

# --- Retention ---
RETENTION_RAW_EVIDENCE_DAYS=90
RETENTION_EVENTS_DAYS=180
RETENTION_AUDIT_DAYS=365

# --- Logging ---
LOG_LEVEL=INFO