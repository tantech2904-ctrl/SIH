{
  "name": "generic-syslog",
  "vendor": "generic",
  "product": "syslog",
  "format": "Syslog",
  "version": "1.0.0",
  "description": "Fallback RFC3164-style syslog for any vendor not covered by a more specific plugin.",
  "match_criteria": {
    "regex": "^<\\d{1,3}>[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+\\S+\\s+"
  },
  "extraction": {
    "type": "regex",
    "pattern": "^<(?P<pri>\\d{1,3})>(?P<rt>[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?P<device>\\S+)\\s+(?P<msg>.*)$"
  },
  "field_mappings": {
    "device": "device", "rt": "timestamp", "msg": "message"
  }
}