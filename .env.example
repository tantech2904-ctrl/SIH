# ==== Application ====
APP_ENV=development
APP_NAME=ULPF
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==== Database ====
DATABASE_URL=postgresql+psycopg://ulpf:ulpf@localhost:5432/ulpf

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== Auth ====
JWT_SECRET=ulpf-local-development-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== Object Storage (MinIO / S3) ====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ulpfadmin
MINIO_SECRET_KEY=ulpfadminsecret
MINIO_BUCKET=ulpf-raw
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ==== Upload limits ====
MAX_UPLOAD_BYTES=52428800
MAX_EVENT_BYTES=1048576

# ==== Syslog UDP ingestion (optional, default off) ====
SYSLOG_UDP_ENABLED=false
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=5140

# ==== Rate limits ====
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_INGEST=600/minute
RATE_LIMIT_SEARCH=120/minute
RATE_LIMIT_ENRICH=60/minute
RATE_LIMIT_REPLAY=30/minute

# ==== Enrichment (all optional) ====
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_UPLOAD_FILES=false

ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=false

OTX_API_KEY=
OTX_ENABLED=false

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=./data/geoip/GeoLite2-City.mmdb
GEOIP_ENABLED=false

RDAP_ENABLED=true
DNS_ENABLED=true

STIX_TAXII_URL=
STIX_TAXII_USER=
STIX_TAXII_PASS=
STIX_TAXII_ENABLED=false

ENRICHMENT_HTTP_TIMEOUT_SECONDS=6
ENRICHMENT_CACHE_TTL_HOURS=24
ENRICHMENT_CIRCUIT_BREAKER_FAILURES=5
ENRICHMENT_CIRCUIT_BREAKER_RESET_SECONDS=60

# ==== Detection ====
RISK_AUTO_QUARANTINE_BELOW_CONFIDENCE=0.55
CORRELATION_WINDOW_SECONDS=300

# ==== Retention (days) ====
RETENTION_RAW_EVIDENCE_DAYS=90
RETENTION_EVENTS_DAYS=180
RETENTION_AUDIT_DAYS=365
RETENTION_CACHE_DAYS=7

# ==== Bootstrap admin ====
BOOTSTRAP_ADMIN_EMAIL=admin@ulpf.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin123!

BOOTSTRAP_ANALYST_EMAIL=analyst@ulpf.local
BOOTSTRAP_ANALYST_PASSWORD=ChangeMe_Analyst123!

BOOTSTRAP_AUDITOR_EMAIL=auditor@ulpf.local
BOOTSTRAP_AUDITOR_PASSWORD=ChangeMe_Auditor123!
